{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=./prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "lint": "echo \"api: no lint configured\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "helius:list": "tsx src/scripts/helius-webhook.ts list",
    "helius:register": "tsx src/scripts/helius-webhook.ts register",
    "helius:ensure": "tsx src/scripts/helius-webhook.ts ensure",
    "helius:delete": "tsx src/scripts/helius-webhook.ts delete",
    "db:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:studio": "node ../../scripts/run-prisma-studio.mjs",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:delete-market": "tsx scripts/delete-market.ts",
    "verify:env": "tsx scripts/verify-env.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@helius-labs/helius-sdk": "npm:helius-sdk@^2.2.2",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@survivefun/solana-pda": "workspace:*",
    "@survivefun/types": "workspace:*",
    "axios": "^1.12.2",
    "bs58": "^6.0.0",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
