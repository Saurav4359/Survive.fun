# Railway / local: copy to .env
# Health check: GET http://localhost:3001/health → {"ok":true}

PORT=3001
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB

# CORS (comma-separated origins, or omit for *)
# CORS_ORIGIN=https://your-app.vercel.app

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SURVIVEFUN_PROGRAM_ID=

# Resolver (on-chain resolve_market)
PLATFORM_WALLET_SECRET_KEY=[1,2,3,...]

# Rug detector
HELIUS_API_KEY=
HELIUS_NETWORK=devnet

# Optional
REDIS_URL=
