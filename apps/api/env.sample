# Railway / local: copy to .env
# Health check: GET http://localhost:3001/health → {"ok":true}

# If you use docker-compose at the repo root, these URLs match the default
# postgres + redis containers (user/password/db from docker-compose.yml).
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/survivefun
REDIS_URL=redis://127.0.0.1:6379

# CORS (comma-separated origins, or omit for *)
# CORS_ORIGIN=https://your-app.vercel.app

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SURVIVEFUN_PROGRAM_ID=

# Resolver (on-chain resolve_market)
PLATFORM_WALLET_SECRET_KEY=[1,2,3,...]

# Rug detector
HELIUS_API_KEY=
HELIUS_NETWORK=devnet
