# Survive.fun API — environment template
# Copy to apps/api/.env (local) or set in Railway → Service → Variables (prod).
# Health check: GET ${BACKEND_URL}/health → {"ok":true}

# ──────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Public origin of the frontend (used to build CORS_ORIGIN; not read by code directly).
FRONTEND_URL=http://localhost:3000

# Public origin of this API (used by `HELIUS_WEBHOOK_URL` and shared in devops.md).
BACKEND_URL=http://localhost:3001

# CORS allowlist (comma-separated). In production the process exits on startup if this is empty.
# CORS_ORIGIN=https://survive.fun,https://www.survive.fun
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────
# Database & cache
# ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/survivefun
REDIS_URL=redis://127.0.0.1:6379

# ──────────────────────────────────────────────────────────────────────
# Solana
# ──────────────────────────────────────────────────────────────────────
# Code reads SOLANA_RPC_URL. SOLANA_RPC kept as alias for spec compatibility — set both.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC=https://api.devnet.solana.com

# Anchor program id (deployed Survive.fun program). MUST match `contracts/contract.md` / IDL `address`.
# Code reads SURVIVEFUN_PROGRAM_ID (PROGRAM_ID is an alias in some scripts).
SURVIVEFUN_PROGRAM_ID=3shYxrDG1srw1Wxu2yVnrnEUk53m6tS8HDyVKuoYLVd1
PROGRAM_ID=3shYxrDG1srw1Wxu2yVnrnEUk53m6tS8HDyVKuoYLVd1

# Legacy SPL reference only (SOL-only program path does not use this).
# USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Resolver / payout signer for on-chain `resolve_market`.
# Code reads PLATFORM_WALLET_SECRET_KEY. PLATFORM_WALLET_SECRET kept as alias.
# Format: JSON byte array, e.g. [1,2,3,...,32 or 64 bytes]
PLATFORM_WALLET_SECRET_KEY=
PLATFORM_WALLET_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Helius (RPC + webhook)
# ──────────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_NETWORK=devnet

# Public HTTPS URL Helius will POST to. MUST be reachable from the public internet.
# Path must end in /webhook/helius (matches Express mount).
# Example: https://api.survive.fun/webhook/helius
HELIUS_WEBHOOK_URL=

# Long random string Helius will send as the `Authorization` header value.
HELIUS_WEBHOOK_AUTH_SECRET=

# Wallet recorded as creator on auto-markets created from Pump.fun TOKEN_MINT events.
AUTO_MARKET_CREATOR_WALLET=

# ──────────────────────────────────────────────────────────────────────
# Optional integrations
# ──────────────────────────────────────────────────────────────────────
# Birdeye (token holders, OHLCV chart, pump curve graduation rule).
BIRDEYE_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Local-only flags (do NOT set in production)
# ──────────────────────────────────────────────────────────────────────
# Allow POST /markets without an on-chain tx (DB-only markets for demos).
# SECURITY: Enables spam / forged listing metadata — never enable in prod.
# ALLOW_DB_ONLY_MARKET_CREATE=true
#
# Skip RPC verification of bet tx signatures (unit/integration tests only).
# SECURITY: Anyone can record fake bets and inflate pools — NEVER true in prod.
# SKIP_TX_VERIFICATION=true
