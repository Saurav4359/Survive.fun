generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenMint       String    @map("token_mint") @db.VarChar(44)
  tokenName       String?   @map("token_name") @db.VarChar(100)
  tokenTicker     String?   @map("token_ticker") @db.VarChar(20)
  creatorWallet   String    @map("creator_wallet") @db.VarChar(44)
  durationSeconds Int       @map("duration")
  expiresAt       DateTime  @map("expires_at") @db.Timestamp(6)
  survivePool     Decimal   @default(0) @map("survive_pool") @db.Decimal(18, 6)
  rugPool         Decimal   @default(0) @map("rug_pool") @db.Decimal(18, 6)
  openPrice       Decimal?  @map("open_price") @db.Decimal(18, 9)
  openLiquidity   Decimal?  @map("open_liquidity") @db.Decimal(18, 2)
  devWallet       String?   @map("dev_wallet") @db.VarChar(44)
  /// Dex/bootstrap snapshot time at market creation (never refetched for rug math).
  openSnapshotAt  DateTime? @map("open_snapshot_at") @db.Timestamp(6)
  /// Demo-only: when set (e.g. 0.05), dev_sell rug ratio uses this instead of 25%.
  devSellThresholdOverride Decimal? @map("dev_sell_threshold_override") @db.Decimal(7, 6)
  /// First rug signal timestamp; second confirmation after ~2m triggers resolution.
  pendingRugAt    DateTime? @map("pending_rug_at") @db.Timestamp(6)
  /// Final automated resolution audit payload (JSON).
  resolutionData  Json?     @map("resolution_data")
  status          String    @default("active") @db.VarChar(20)
  outcome         String?   @db.VarChar(10)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  rugCondition    String?   @map("rug_condition") @db.VarChar(50)
  onChainAddress  String?   @map("on_chain_address") @db.VarChar(44)
  /// Second PDA seed (`market_id` pubkey) — new markets only; null = legacy `[market, mint]` layout.
  chainMarketKey  String?   @map("chain_market_key") @db.VarChar(44)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  totalBettors    Int       @default(0) @map("total_bettors")
  currency        String    @default("usdc") @db.VarChar(10)

  bets      Bet[]
  rugEvents RugEvent[]

  // Enforced in DB: partial unique on (token_mint, duration) WHERE status = 'active'
  // (see migration 20260509120000_markets_active_mint_duration_unique).
  @@map("markets")
}

model Bet {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketId      String    @map("market_id") @db.Uuid
  bettorWallet  String    @map("bettor_wallet") @db.VarChar(44)
  side          String    @db.VarChar(10)
  amountUsdc    Decimal   @map("amount_usdc") @db.Decimal(18, 6)
  potentialWin  Decimal?  @map("potential_win") @db.Decimal(18, 6)
  txSignature   String    @unique @map("tx_signature") @db.VarChar(88)
  currency      String    @default("usdc") @db.VarChar(10)
  won           Boolean   @default(false)
  claimed       Boolean   @default(false)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamp(6)
  payoutAmount  Decimal?  @map("payout_amount") @db.Decimal(18, 6)
  payoutTx      String?   @map("payout_tx") @db.VarChar(88)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  market Market @relation(fields: [marketId], references: [id])

  @@map("bets")
}

model RugEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketId    String   @map("market_id") @db.Uuid
  tokenMint   String   @map("token_mint") @db.VarChar(44)
  eventType   String   @map("event_type") @db.VarChar(50)
  eventData   Json?    @map("event_data")
  txSignature String?  @map("tx_signature") @db.VarChar(88)
  detectedAt  DateTime @default(now()) @map("detected_at") @db.Timestamp(6)

  market Market @relation(fields: [marketId], references: [id])

  @@map("rug_events")
}

model PlatformStats {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  totalMarkets  Int      @default(0) @map("total_markets")
  totalVolume   Decimal  @default(0) @map("total_volume") @db.Decimal(18, 6)
  totalFees     Decimal  @default(0) @map("total_fees") @db.Decimal(18, 6)
  totalRugs     Int      @default(0) @map("total_rugs")
  totalSurvives Int      @default(0) @map("total_survives")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("platform_stats")
}
