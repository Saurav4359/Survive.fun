# Survive.fun web — environment template
# Copy to apps/web/.env.local (local). Set the same vars in Vercel → Project → Settings → Environment Variables.

# ──────────────────────────────────────────────────────────────────────
# API
# ──────────────────────────────────────────────────────────────────────
# Origin of the Survive.fun API. Socket.IO uses this origin only.
# In Vercel set this to the public Railway URL, e.g. https://api.survive.fun
NEXT_PUBLIC_API_URL=http://localhost:3001

# REST path prefix on that origin. Code defaults to /v1.
# NEXT_PUBLIC_API_V1_PREFIX=/v1

# ──────────────────────────────────────────────────────────────────────
# Solana
# ──────────────────────────────────────────────────────────────────────
# Solana RPC endpoint. Falls back to public devnet if unset.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed Survive.fun program id (must match SURVIVEFUN_PROGRAM_ID on the API).
NEXT_PUBLIC_PROGRAM_ID=HB3uE5XQGq1xNtW9RMSrnBegwifeLzk1xyr75ofRPrtH

# Circle USDC devnet mint. The web app currently hard-codes this in src/utils/constants.ts;
# expose here for parity with the spec and future override paths.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional: platform authority pubkey used by create_market / claim
# (must equal the API's PLATFORM_WALLET_SECRET_KEY pubkey in production).
# NEXT_PUBLIC_PLATFORM_AUTHORITY=
