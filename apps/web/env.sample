# Copy to .env.local for local dev. Set these in Vercel → Project → Settings → Environment Variables.

# Required: Survive.fun API (Socket.IO + REST)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solana RPC (defaults to public devnet if unset)
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# On-chain program id (must match deployed Survive.fun program)
# NEXT_PUBLIC_PROGRAM_ID=

# Optional: platform authority for create_market / claim (must match API signer in production)
# NEXT_PUBLIC_PLATFORM_AUTHORITY=
