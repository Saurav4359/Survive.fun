{
  "name": "survivefun",
  "private": true,
  "description": "Survive.fun monorepo. Postgres + Redis for local dev: pnpm docker:up (see docker-compose.yml).",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --dir apps/api run test",
    "setup-demo": "prisma generate --schema=apps/api/prisma/schema.prisma && ts-node --project tsconfig.scripts.json scripts/setup-demo.ts",
    "setup-demo-onchain": "prisma generate --schema=apps/api/prisma/schema.prisma && ts-node --transpile-only --project tsconfig.scripts.json scripts/setup-demo-onchain.ts",
    "test-flow": "ts-node --project tsconfig.scripts.json scripts/test-flow.ts",
    "test-rug-detector": "ts-node --transpile-only --project tsconfig.scripts.json scripts/test-rug-detector.ts",
    "test-integration": "ts-node --transpile-only --project tsconfig.scripts.json scripts/test-integration.ts",
    "test-contracts": "pnpm --dir contracts test",
    "verify-demo": "ts-node --transpile-only --project tsconfig.scripts.json scripts/verify-demo.ts",
    "simulate-rug": "ts-node --project tsconfig.scripts.json scripts/simulate-rug.ts",
    "simulate-survive": "ts-node --project tsconfig.scripts.json scripts/simulate-survive.ts",
    "test-resolution": "prisma generate --schema=apps/api/prisma/schema.prisma && tsx scripts/test-resolution.ts",
    "check-onchain": "prisma generate --schema=apps/api/prisma/schema.prisma && tsx scripts/check-onchain.ts",
    "pda:audit": "prisma generate --schema=apps/api/prisma/schema.prisma && pnpm --dir apps/api exec tsx scripts/pda-migration-audit.ts",
    "pda:backfill-keys": "prisma generate --schema=apps/api/prisma/schema.prisma && pnpm --dir apps/api exec tsx scripts/pda-backfill-chain-market-key.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "demo": "tsx scripts/setup-demo.ts",
    "db:generate": "pnpm --dir apps/api exec prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:dev": "pnpm --dir apps/api exec prisma migrate dev --schema=./prisma/schema.prisma",
    "db:migrate:deploy": "pnpm --dir apps/api exec prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:reset": "pnpm --dir apps/api exec prisma migrate reset --schema=./prisma/schema.prisma",
    "db:studio": "node scripts/run-prisma-studio.mjs"
  },
  "devDependencies": {
    "@survivefun/solana-pda": "workspace:^",
    "@survivefun/types": "workspace:^",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^20.17.10",
    "dotenv": "^16.4.7",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
